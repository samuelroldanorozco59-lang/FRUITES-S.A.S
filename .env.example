# ============================================================================
# FRUTASO — VARIABLES DE ENTORNO DE EJEMPLO
# ============================================================================
# Copia este archivo y nómbralo exactamente '.env' en la raíz de tu proyecto.
# Si dejas estas variables vacías o sin configurar, el sitio web funcionará
# de inmediato en "Modo Demostración" sin romperse.
# ============================================================================

# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=""

# Clave pública anónima de Supabase (Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=""

# Ruta base para GitHub Pages (opcional, './' funciona automáticamente en cualquier subcarpeta)
VITE_BASE_PATH="./"
